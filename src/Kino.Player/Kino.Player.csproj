<Project Sdk="Microsoft.NET.Sdk">

  <!-- libmpv bindings and the Win32 video host. No UI framework dependency. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Kino.Player</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- x64, x86 and ARM64 builds, each with its own libmpv (tools/Fetch-LibMpv.ps1 -Arch ...). Default: x64. -->
    <Platforms>x64;x86;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <KinoArch>$(Platform.ToLowerInvariant())</KinoArch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kino.Core\Kino.Core.csproj" />
  </ItemGroup>

  <!-- libmpv is fetched by tools/Fetch-LibMpv.ps1 into libs/mpv/<arch> (not committed) -->
  <ItemGroup>
    <None Include="..\..\libs\mpv\$(KinoArch)\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CheckLibMpv" BeforeTargets="Build">
    <Error Condition="!Exists('..\..\libs\mpv\$(KinoArch)\libmpv-2.dll')"
           Text="libmpv-2.dll for $(KinoArch) not found. Run tools\Fetch-LibMpv.ps1 -Arch $(KinoArch) first." />
  </Target>

</Project>
