<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kino.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kino"
    Title="Kino">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LobbyButton" Grid.Column="0" Content="Lobby" Click="OnLobbyButtonClick" MinWidth="110" />
            <TextBox x:Name="NameBox" Grid.Column="1" PlaceholderText="Your name" MaxLength="32" />
            <TextBlock x:Name="SessionText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Not in a screen" Opacity="0.8" />
            <ToggleButton x:Name="ViewersToggle" Grid.Column="3" Content="Viewers" Click="OnViewersToggle"
                          Visibility="Collapsed" />
            <Button x:Name="LeaveButton" Grid.Column="4" Content="Leave screen" Click="OnLeaveClick" Visibility="Collapsed" />
        </Grid>

        <!-- Stage: video, plus the viewers panel beside it (never over it: XAML can't draw over the video window). -->
        <Grid x:Name="StageGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- The native video window is positioned exactly over this element. -->
            <Border x:Name="VideoArea" Grid.Column="0" Background="Black" />

            <Grid x:Name="SidePanel" Grid.Column="1" Padding="12,4,12,8" RowSpacing="6"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="SideTabs" Grid.Row="0" SelectionChanged="OnSideTabChanged">
                    <SelectorBarItem x:Name="ViewersTab" Text="Viewers" IsSelected="True" />
                    <SelectorBarItem x:Name="PlaylistTab" Text="Playlist" />
                    <SelectorBarItem x:Name="ChatTab" Text="Chat" />
                </SelectorBar>

                <Grid x:Name="ViewersSection" Grid.Row="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ViewersHeader" Grid.Row="0" Text="Viewers" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="ViewersList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnViewerClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ViewerRow">
                            <StackPanel Padding="0,6" Opacity="{x:Bind RowOpacity}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind ColourBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <FontIcon Glyph="&#xE74F;" FontSize="12" Visibility="{x:Bind MutedVisibility}"
                                              ToolTipService.ToolTip="Chat-muted" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Badges}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                           Visibility="{x:Bind BadgesVisibility}" />
                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="AwayCoHostsText" Grid.Row="2" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <StackPanel Grid.Row="3" Orientation="Vertical" Spacing="8">
                    <Button x:Name="ScreenButton" Content="Invite &amp; settings…" Click="OnScreenClick" />
                    <Button x:Name="RolesButton" Content="Roles…" Click="OnRolesClick" />
                    <Button x:Name="CloseScreenButton" Content="Close screen" Click="OnCloseScreenClick" />
                </StackPanel>
                </Grid>

                <Grid x:Name="ChatSection" Grid.Row="1" RowSpacing="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="ChatList" Grid.Row="0" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ChatRow">
                                <StackPanel Padding="0,4" Spacing="2">
                                    <TextBlock Visibility="{x:Bind HeaderVisibility}" FontSize="12">
                                        <Run Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{x:Bind NameBrush}" />
                                        <Run Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Visibility="{x:Bind TextVisibility}" Opacity="{x:Bind TextOpacity}"
                                               FontStyle="{x:Bind TextStyle}" FontSize="{x:Bind TextSize}" />
                                    <Image Source="{x:Bind GifSource}" Visibility="{x:Bind GifVisibility}" MaxHeight="150"
                                           MaxWidth="250" HorizontalAlignment="Left" Stretch="Uniform" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="ReactionBar" Grid.Row="1" Orientation="Horizontal" Spacing="2" />

                    <Grid x:Name="GifPicker" Grid.Row="2" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="GifSearchBox" Grid.Row="0" PlaceholderText="Search GIFs" KeyUp="OnGifSearchKeyUp" />
                        <StackPanel x:Name="GifKeyRow" Grid.Row="1" Spacing="6" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                                       Text="GIF search uses GIPHY, which needs a free API key (developers.giphy.com → Create an app → API). It stays on this PC. You can also paste a GIF link into the message box." />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox x:Name="GifKeyBox" PlaceholderText="GIPHY API key" Width="180" />
                                <Button Content="Save" Click="OnSaveGifKeyClick" />
                            </StackPanel>
                        </StackPanel>
                        <GridView x:Name="GifResults" Grid.Row="2" MaxHeight="220" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="OnGifClick">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:GifTile">
                                    <Image Source="{x:Bind Preview}" Width="80" Height="60" Stretch="UniformToFill" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" PlaceholderText="Message" MaxLength="500" KeyUp="OnChatInputKeyUp" />
                        <ToggleButton x:Name="GifToggle" Grid.Column="1" Content="GIF" Click="OnGifToggle" />
                        <Button x:Name="SendChatButton" Grid.Column="2" Content="Send" Click="OnSendChatClick"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                </Grid>

                <Grid x:Name="PlaylistSection" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PlaylistHeader" Grid.Row="0" Text="Playlist" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ListView x:Name="PlaylistList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnPlaylistItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistRow">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind Weight}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                               Foreground="{x:Bind DetailBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="AddLinkRow" Grid.Row="2" Spacing="6" Visibility="Collapsed">
                        <TextBox x:Name="LinkBox" PlaceholderText="https://…/video.mp4" KeyUp="OnLinkKeyUp" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add link" Click="OnAddLinkConfirm" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="Cancel" Click="OnAddLinkCancel" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock x:Name="PlaylistStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="AddFilesButton" Content="Add files…" Click="OnAddFilesClick" />
                            <Button x:Name="AddFolderButton" Content="Add folder…" Click="OnAddFolderClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="AddLinkButton" Content="Add link…" Click="OnAddLinkClick" />
                            <Button x:Name="MatchFilesButton" Content="Match my files…" Click="OnMatchFilesClick"
                                    ToolTipService.ToolTip="Pick a folder with your copies; Kino matches them to the playlist" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Lobby. While it is shown, the native video window is hidden so XAML can draw here. -->
        <Grid x:Name="LobbyPanel" Grid.Row="1" Padding="16,8,16,16" ColumnSpacing="16"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Screens from every theatre -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search screens"
                             ToolTipService.ToolTip="Search by screen name, host name or exact code"
                             TextChanged="OnLobbyQueryChanged" />
                    <ComboBox x:Name="VisibilityFilterBox" Grid.Column="1" SelectedIndex="0" MinWidth="110"
                              SelectionChanged="OnLobbyQueryChanged">
                        <x:String>All screens</x:String>
                        <x:String>Public</x:String>
                        <x:String>Private</x:String>
                    </ComboBox>
                    <ComboBox x:Name="TheatreFilterBox" Grid.Column="2" MinWidth="130" SelectionChanged="OnLobbyQueryChanged" />
                    <ComboBox x:Name="SortBox" Grid.Column="3" SelectedIndex="0" MinWidth="130"
                              SelectionChanged="OnLobbyQueryChanged">
                        <x:String>Most viewers</x:String>
                        <x:String>Lowest ping</x:String>
                        <x:String>Name</x:String>
                    </ComboBox>
                    <Button x:Name="RefreshButton" Grid.Column="4" Content="Refresh" Click="OnRefreshClick" />
                </Grid>

                <StackPanel x:Name="TheatreStrip" Grid.Row="1" Orientation="Horizontal" Spacing="6" />
                <TextBlock x:Name="LobbyStatusText" Grid.Row="2" Opacity="0.7" Text="Loading theatres…" />

                <ListView x:Name="LobbyList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnLobbyItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LobbyRow">
                            <Grid Padding="4,8" ColumnSpacing="12" Opacity="{x:Bind RowOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind LockVisibility}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="8,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Theatre}" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{x:Bind Viewers}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Ping}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Opacity="0.7" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Join and create -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Join a screen" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="JoinTargetText" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBox x:Name="CodeBox" PlaceholderText="Screen code, e.g. 7K3QXM" MaxLength="12"
                                 CharacterCasing="Upper" TextChanged="OnCodeChanged" KeyUp="OnCodeKeyUp" />
                        <PasswordBox x:Name="JoinPasswordBox" PlaceholderText="Password" Visibility="Collapsed"
                                     KeyUp="OnJoinPasswordKeyUp" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="JoinButton" Content="Join" Click="OnJoinClick" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="CancelJoinButton" Content="Cancel" Click="OnCancelJoinClick" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="JoinMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Create a screen" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="ScreenNameBox" Header="Screen name" PlaceholderText="Movie night" MaxLength="64"
                                 TextChanged="OnCreateFormChanged" />
                        <ComboBox x:Name="TheatrePicker" Header="Theatre" HorizontalAlignment="Stretch"
                                  PlaceholderText="Loading theatres…" IsEnabled="False" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch x:Name="PrivateSwitch" Header="Visibility" OffContent="Public" OnContent="Private"
                                          Toggled="OnCreateFormChanged" />
                            <NumberBox x:Name="MaxViewersBox" Grid.Column="1" Header="Max viewers" Value="10" Minimum="2"
                                       Maximum="25" SpinButtonPlacementMode="Compact" SmallChange="1" />
                        </Grid>
                        <PasswordBox x:Name="CreatePasswordBox" PlaceholderText="Password (required)" Visibility="Collapsed"
                                     PasswordChanged="OnCreateFormChanged" />
                        <CheckBox x:Name="HideFromLobbyBox" Content="Hide from lobby (join by code only)" Visibility="Collapsed" />
                        <Button x:Name="CreateButton" Content="Create screen" Click="OnCreateClick" IsEnabled="False"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <TextBlock x:Name="CreateMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Roles and per-viewer permissions. Like the lobby, it hides the video window while shown. -->
        <Grid x:Name="RolesPanel" Grid.Row="1" Padding="16,8,16,16" ColumnSpacing="24" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Roles" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ListView x:Name="RolesList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnRoleSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RoleRow">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,6">
                                <Ellipse Width="10" Height="10" Fill="{x:Bind ColourBrush}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NewRoleButton" Content="New role" Click="OnNewRoleClick" />
                    <Button Content="Done" Click="OnRolesDoneClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="EditorTitle" Text="Select a role" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="EditorHint" Opacity="0.7" TextWrapping="Wrap" />
                    <Grid x:Name="RoleFields" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RoleNameBox" Header="Name" MaxLength="32" />
                        <ComboBox x:Name="RoleColourBox" Grid.Column="1" Header="Colour" HorizontalAlignment="Stretch" />
                        <NumberBox x:Name="RoleRankBox" Grid.Column="2" Header="Rank" Minimum="1" Maximum="899"
                                   SpinButtonPlacementMode="Compact"
                                   ToolTipService.ToolTip="Higher ranks can manage lower ones (1–899)" />
                    </Grid>
                    <StackPanel x:Name="PermissionChecks" Spacing="2" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveRoleButton" Content="Save" Click="OnSaveRoleClick" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="DeleteRoleButton" Content="Delete role" Click="OnDeleteRoleClick" />
                    </StackPanel>
                    <TextBlock x:Name="RolesMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Invite and screen settings. Hides the video window while shown, like the lobby. -->
        <Grid x:Name="ScreenPanel" Grid.Row="1" Padding="24,12,24,16" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Invite" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="InviteCodeText" FontSize="34" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="InviteLinkText" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyInviteButton" Content="Copy invite link" Click="OnCopyInviteClick"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <Button Content="Copy code" Click="OnCopyCodeClick" />
                        <Button x:Name="RegenerateCodeButton" Content="New code" Click="OnRegenerateCodeClick" />
                    </StackPanel>
                    <TextBlock x:Name="InviteHint" Opacity="0.7" TextWrapping="Wrap" />

                    <TextBlock Text="Settings" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock x:Name="SettingsHint" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBox x:Name="SettingsNameBox" Header="Screen name" MaxLength="64" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="SettingsPrivateSwitch" Header="Visibility" OffContent="Public" OnContent="Private"
                                      Toggled="OnSettingsPrivateToggled" />
                        <NumberBox x:Name="SettingsMaxViewersBox" Grid.Column="1" Header="Max viewers" Minimum="2" Maximum="25"
                                   SpinButtonPlacementMode="Compact" SmallChange="1" />
                    </Grid>
                    <PasswordBox x:Name="SettingsPasswordBox" Header="Password" />
                    <CheckBox x:Name="SettingsHiddenBox" Content="Hide from lobby (join by code only)" />
                    <ToggleSwitch x:Name="SettingsDevicesSwitch" Header="Viewers' devices" OnContent="Shown to everyone"
                                  OffContent="Hidden" />
                    <ToggleSwitch x:Name="SettingsAutoAdvanceSwitch" Header="When an item ends" OnContent="Play the next one"
                                  OffContent="Stop" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveSettingsButton" Content="Save settings" Click="OnSaveSettingsClick"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <Button Content="Done" Click="OnScreenDoneClick" />
                    </StackPanel>
                    <TextBlock x:Name="SettingsMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Floating reactions over the video (windowed popup, like the sync overlay). -->
        <Popup x:Name="ReactionPopup" ShouldConstrainToRootBounds="False" IsHitTestVisible="False">
            <StackPanel x:Name="ReactionStack" Spacing="4" />
        </Popup>

        <!-- Sync overlay: a windowed popup renders in its own HWND, so it sits above the video. -->
        <Popup x:Name="OverlayPopup" ShouldConstrainToRootBounds="False">
            <Border Background="#B0202020" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="OverlayTitle" Text="Kino" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock x:Name="OverlayText" Text="Open a file or join a screen" Foreground="#DDFFFFFF"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenButton" Grid.Column="0" Content="Open…" Click="OnOpenClick" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PreviousButton" Content="&#x23EE;" Click="OnPreviousClick" Visibility="Collapsed"
                        ToolTipService.ToolTip="Previous item" />
                <Button x:Name="PlayPauseButton" Content="Play" Click="OnPlayPauseClick" MinWidth="72" />
                <Button x:Name="NextButton" Content="&#x23ED;" Click="OnNextClick" Visibility="Collapsed"
                        ToolTipService.ToolTip="Next item" />
            </StackPanel>
            <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    StepFrequency="0.1" IsThumbToolTipEnabled="False"
                    PointerCaptureLost="OnSeekCommitted" KeyUp="OnSeekKey" />
            <TextBlock x:Name="TimeText" Grid.Column="3" VerticalAlignment="Center" Text="00:00 / 00:00"
                       FontFamily="Consolas" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Vol" VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="200" Value="100"
                        IsThumbToolTipEnabled="False" ValueChanged="OnVolumeChanged" />
            </StackPanel>
            <ToggleButton x:Name="OverlayToggle" Grid.Column="5" Content="Overlay" IsChecked="True"
                          Click="OnOverlayToggle" />
        </Grid>
    </Grid>
</Window>
