<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kino.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kino">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The native video window is positioned exactly over this element. -->
        <Border x:Name="VideoArea" Grid.Row="0" Background="Black" />

        <!-- Overlay test: a windowed popup renders in its own HWND, so it can sit above the video. -->
        <Popup x:Name="OverlayPopup" ShouldConstrainToRootBounds="False">
            <Border Background="#B0202020" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Kino overlay" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock x:Name="OverlayText" Text="Drawn above the video" Foreground="#DDFFFFFF" />
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenButton" Grid.Column="0" Content="Open…" Click="OnOpenClick" />
            <Button x:Name="PlayPauseButton" Grid.Column="1" Content="Play" Click="OnPlayPauseClick" MinWidth="72" />
            <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    StepFrequency="0.1" IsThumbToolTipEnabled="False" ValueChanged="OnSeekChanged" />
            <TextBlock x:Name="TimeText" Grid.Column="3" VerticalAlignment="Center" Text="00:00 / 00:00"
                       FontFamily="Consolas" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Speed" VerticalAlignment="Center" />
                <Slider x:Name="SpeedSlider" Width="120" Minimum="0.90" Maximum="1.10" StepFrequency="0.005"
                        Value="1.0" IsThumbToolTipEnabled="False" ValueChanged="OnSpeedChanged" />
                <TextBlock x:Name="SpeedText" Text="1.000×" FontFamily="Consolas" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Vol" VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="200" Value="100"
                        IsThumbToolTipEnabled="False" ValueChanged="OnVolumeChanged" />
            </StackPanel>
            <ToggleButton x:Name="OverlayToggle" Grid.Column="6" Content="Overlay" IsChecked="True"
                          Click="OnOverlayToggle" />
        </Grid>
    </Grid>
</Window>
