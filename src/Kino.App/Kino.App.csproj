<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Kino</RootNamespace>
    <AssemblyName>Kino</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Platforms>x64;x86;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <KinoArch>$(Platform.ToLowerInvariant())</KinoArch>
    <RuntimeIdentifier>win-$(KinoArch)</RuntimeIdentifier>

    <!-- WinUI 3, unpackaged, self-contained Windows App SDK: runs without admin or runtime installers -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Kino.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon at run time (the exe icon comes from ApplicationIcon). -->
    <Content Include="Assets\Kino.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kino.Player\Kino.Player.csproj" />
    <ProjectReference Include="..\Kino.Core\Kino.Core.csproj" />
  </ItemGroup>

  <!-- Unpackaged WinUI publish leaves out the resource index and compiled XAML; without them the window can't load. -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_KinoXamlResources Include="$(OutDir)$(TargetName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_KinoXamlResources)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>


</Project>
